
@{
    Layout = null;
    ViewBag.Title = "¿Qué está ocultando? - Amor Bajo Lupa";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>¿Qué está ocultando? | Amor Bajo Lupa</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: "Segoe UI", Arial, sans-serif;
            color: #30283a;
            background: linear-gradient(135deg, #f1e5ff 0%, #fbf5ff 48%, #ffe8f3 100%);
            padding: 30px 16px;
        }

        button, input, select, textarea {
            font: inherit;
        }

        [hidden] {
            display: none !important;
        }

        .encabezado {
            text-align: center;
            margin-bottom: 25px;
        }

        .marca {
            color: #713787;
            font-size: 25px;
            font-weight: 800;
            text-decoration: none;
            letter-spacing: .3px;
        }

        .contenedor {
            max-width: 850px;
            margin: auto;
        }

        .tarjeta {
            background: rgba(255,255,255,.94);
            border-radius: 28px;
            padding: 38px;
            box-shadow: 0 12px 40px rgba(91, 50, 115, .12);
            border: 1px solid rgba(255,255,255,.8);
        }

        .etiqueta {
            display: inline-block;
            background: #f2e5fa;
            color: #713787;
            border-radius: 30px;
            padding: 8px 17px;
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 15px;
        }

        h1 {
            color: #713787;
            font-size: 32px;
            margin: 0 0 12px;
            text-align: center;
        }

        .descripcion {
            text-align: center;
            color: #81788b;
            line-height: 1.7;
            max-width: 650px;
            margin: 0 auto 28px;
        }

        .aviso {
            background: #fff5fa;
            border-left: 4px solid #dc8fb9;
            border-radius: 12px;
            padding: 14px 17px;
            color: #6f596b;
            font-size: 13px;
            line-height: 1.6;
            margin-bottom: 25px;
        }

        .datos-pregunta {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
            color: #81788b;
            font-size: 14px;
            margin-bottom: 12px;
        }

        .categoria {
            color: #9251a8;
            font-weight: 700;
        }

        .barra-fondo {
            width: 100%;
            height: 10px;
            background: #eee6f3;
            border-radius: 20px;
            overflow: hidden;
            margin-bottom: 32px;
        }

        .barra-progreso {
            width: 0%;
            height: 100%;
            background: linear-gradient(90deg, #9251a8, #dc8fb9);
            border-radius: 20px;
            transition: width .3s ease;
        }

        .numero {
            color: #dc8fb9;
            font-weight: 800;
            font-size: 15px;
            margin-bottom: 10px;
        }

        .pregunta {
            font-size: 22px;
            color: #30283a;
            line-height: 1.5;
            margin: 0 0 25px;
        }

        .opciones {
            display: grid;
            gap: 13px;
        }

        .opcion {
            display: flex;
            align-items: center;
            gap: 13px;
            border: 2px solid #eee7f2;
            border-radius: 15px;
            padding: 16px 18px;
            cursor: pointer;
            transition: .2s ease;
            color: #51475a;
            line-height: 1.5;
        }

        .opcion:hover {
            border-color: #c99bd9;
            background: #fcf8ff;
        }

        .opcion.seleccionada {
            border-color: #9251a8;
            background: #f7edfc;
            color: #713787;
            font-weight: 600;
        }

        .opcion input {
            accent-color: #9251a8;
            width: 19px;
            height: 19px;
            flex-shrink: 0;
        }

        .navegacion {
            display: flex;
            justify-content: space-between;
            gap: 14px;
            margin-top: 30px;
        }

        .btn {
            border: none;
            border-radius: 30px;
            padding: 13px 27px;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            transition: .2s ease;
        }

        .btn-principal {
            color: white;
            background: linear-gradient(135deg, #9251a8, #bd79bd);
            box-shadow: 0 5px 14px rgba(146, 81, 168, .2);
        }

        .btn-principal:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 18px rgba(146, 81, 168, .3);
        }

        .btn-secundario {
            background: #f1e8f5;
            color: #713787;
        }

        .btn:disabled {
            opacity: .45;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

        .ayuda {
            text-align: center;
            color: #a096aa;
            font-size: 12px;
            margin-top: 18px;
        }

        /* Resultados */

        .resultado {
            text-align: center;
        }

        .circulo {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            margin: 25px auto;
            background: linear-gradient(135deg, #9251a8, #dc8fb9);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: white;
            box-shadow: 0 8px 25px rgba(146, 81, 168, .2);
        }

        .circulo strong {
            font-size: 38px;
        }

        .circulo span {
            font-size: 12px;
        }

        .mensaje-resultado {
            background: #fbf5ff;
            padding: 20px;
            border-radius: 16px;
            color: #66556d;
            line-height: 1.7;
            margin: 20px 0;
        }

        .subtitulo {
            color: #713787;
            font-size: 20px;
            margin-top: 32px;
            margin-bottom: 17px;
        }

        .categoria-resultado {
            text-align: left;
            margin-bottom: 17px;
        }

        .categoria-cabecera {
            display: flex;
            justify-content: space-between;
            gap: 10px;
            font-size: 14px;
            margin-bottom: 7px;
        }

        .categoria-cabecera strong {
            color: #713787;
        }

        .categoria-barra {
            height: 9px;
            background: #eee6f3;
            border-radius: 20px;
            overflow: hidden;
        }

        .categoria-relleno {
            height: 100%;
            background: linear-gradient(90deg, #9251a8, #dc8fb9);
            border-radius: 20px;
        }

        .nota-final {
            color: #81788b;
            font-size: 13px;
            line-height: 1.7;
            margin: 25px 0;
        }

        .acciones-resultado {
            display: flex;
            justify-content: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        @@media (max-width: 600px) {
            body {
                padding: 18px 10px;
            }

            .tarjeta {
                padding: 25px 19px;
                border-radius: 22px;
            }

            h1 {
                font-size: 26px;
            }

            .pregunta {
                font-size: 19px;
            }

            .navegacion {
                flex-direction: column-reverse;
            }

            .navegacion .btn {
                width: 100%;
            }
        }
    
        /* ===== IDENTIDAD VISUAL COMPARTIDA: AMOR BAJO LUPA ===== */
        :root {
            --abl-primary: #9251a8;
            --abl-primary-dark: #713787;
            --abl-pink: #dc8fb9;
            --abl-text: #39264d;
            --abl-muted: #7b7087;
            --abl-border: #eee5f2;
            --abl-soft: #f8f1fc;
            --abl-white: #ffffff;
        }

        body {
            font-family: "Segoe UI", Arial, sans-serif;
            color: var(--abl-text);
            background: linear-gradient(135deg, #f1e5ff 0%, #fbf5ff 48%, #ffe8f3 100%);
        }

        body::before,
        body::after {
            display: none;
        }

        .pagina,
        .contenedor {
            width: min(100%, 850px);
            max-width: 850px;
            margin-left: auto;
            margin-right: auto;
        }

        .tarjeta-inicio,
        .tarjeta,
        .card {
            width: 100%;
            max-width: 850px;
            margin-left: auto;
            margin-right: auto;
            padding: 38px 42px;
            border: 1px solid rgba(234, 227, 240, .95);
            border-radius: 26px;
            background: rgba(255, 255, 255, .96);
            box-shadow: 0 18px 55px rgba(87, 49, 104, .10);
        }

        .tarjeta-inicio {
            text-align: center;
        }

        h1,
        .tarjeta-inicio h1,
        .tarjeta h1,
        .card h1 {
            color: #633b7e;
            font-family: "Segoe UI", Arial, sans-serif;
            font-size: clamp(30px, 4vw, 38px);
            font-weight: 800;
            letter-spacing: -.8px;
            line-height: 1.2;
        }

        h2,
        .pregunta,
        #pregunta,
        #textoPregunta {
            color: #514269;
            font-size: 22px;
            font-weight: 700;
            line-height: 1.5;
        }

        .subtitulo,
        .descripcion {
            color: #756b83;
            font-size: 16px;
            line-height: 1.75;
        }

        .etiqueta,
        #contador,
        .contador,
        .numero,
        .categoria {
            border-radius: 999px;
            color: var(--abl-primary-dark);
        }

        .etiqueta {
            padding: 7px 14px;
            background: #f5eafb;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: .5px;
        }

        .marca {
            color: var(--abl-primary-dark);
            font-family: "Segoe UI", Arial, sans-serif;
            font-size: 23px;
            font-weight: 800;
            text-decoration: none;
        }

        /* Tarjetas de respuesta: mismo tamaño, borde y estado seleccionado. */
        .option,
        .opcion {
            display: flex;
            width: 100%;
            min-height: 60px;
            align-items: center;
            justify-content: flex-start;
            gap: 12px;
            margin: 0;
            padding: 16px 18px;
            border: 1.5px solid var(--abl-border);
            border-radius: 15px;
            background: #fff;
            color: #5e526c;
            font-family: "Segoe UI", Arial, sans-serif;
            font-size: 15px;
            font-weight: 400;
            line-height: 1.5;
            text-align: left;
            cursor: pointer;
            transition: border-color .2s ease, background .2s ease, box-shadow .2s ease, transform .2s ease;
        }

        .option:hover,
        .opcion:hover {
            border-color: #c39bd5;
            background: #fcf8ff;
            transform: translateY(-1px);
            box-shadow: 0 5px 15px rgba(117, 70, 143, .07);
        }

        .option:has(input:checked),
        .opcion:has(input:checked),
        .opcion.seleccionada {
            border-color: var(--abl-primary);
            background: #f7effb;
            color: var(--abl-primary-dark);
        }

        .option input,
        .opcion input {
            width: 19px;
            height: 19px;
            flex: 0 0 19px;
            margin: 0 2px 0 0;
            accent-color: var(--abl-primary);
        }

        .option:focus-within,
        .opcion:focus-within {
            outline: 3px solid #dfc4e9;
            outline-offset: 2px;
        }

        .opciones {
            gap: 12px;
        }

        /* Barras de progreso unificadas. */
        .progress,
        .barra-fondo {
            height: 9px;
            overflow: hidden;
            border-radius: 999px;
            background: #eee7f2;
        }

        .progress-bar,
        .barra,
        .barra-progreso {
            height: 100%;
            border-radius: inherit;
            background: linear-gradient(90deg, #9251a8, #dc8fb9);
            transition: width .3s ease;
        }

        /* Todos los botones principales comparten dimensiones y degradado. */
        .btn-comenzar,
        .boton:not(.boton-secundario),
        .btn:not(.btn-secondary):not(.btn-secundario),
        .btn-principal {
            display: inline-flex;
            min-width: 190px;
            min-height: 48px;
            max-width: 100%;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 13px 22px;
            border: 1px solid transparent;
            border-radius: 14px;
            background: linear-gradient(135deg, #9251a8, #713787);
            box-shadow: 0 7px 18px rgba(146, 81, 168, .20);
            color: #fff;
            font-family: "Segoe UI", Arial, sans-serif;
            font-size: 15px;
            font-weight: 700;
            line-height: 1.25;
            text-align: center;
            text-decoration: none;
            cursor: pointer;
            transition: transform .2s ease, box-shadow .2s ease, background .2s ease;
        }

        .btn-comenzar:hover,
        .boton:not(.boton-secundario):hover,
        .btn:not(.btn-secondary):not(.btn-secundario):hover,
        .btn-principal:hover {
            background: linear-gradient(135deg, #85449c, #60306f);
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 10px 23px rgba(146, 81, 168, .27);
        }

        .btn-secondary,
        .boton-secundario,
        .btn-secundario,
        .btn-volver {
            display: inline-flex;
            min-width: 180px;
            min-height: 46px;
            max-width: 100%;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 11px 20px;
            border: 1px solid #e8daf1;
            border-radius: 14px;
            background: #f8f1fc;
            box-shadow: none;
            color: var(--abl-primary-dark);
            font-family: "Segoe UI", Arial, sans-serif;
            font-size: 14px;
            font-weight: 700;
            line-height: 1.3;
            text-align: center;
            text-decoration: none;
            cursor: pointer;
            transition: transform .2s ease, background .2s ease, border-color .2s ease;
        }

        .btn-secondary:hover,
        .boton-secundario:hover,
        .btn-secundario:hover,
        .btn-volver:hover {
            border-color: #d9c2e6;
            background: #eee1f7;
            color: var(--abl-primary-dark);
            transform: translateY(-1px);
            box-shadow: none;
        }

        .btn:disabled {
            opacity: .45;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

        .btn-comenzar:focus-visible,
        .boton:focus-visible,
        .btn:focus-visible,
        .btn-volver:focus-visible {
            outline: 3px solid #d8b6e8;
            outline-offset: 3px;
        }

        /* Resultados con la misma superficie visual. */
        .result-box,
        .caja-resultado,
        .mensaje-resultado,
        .interpretacion {
            padding: 20px;
            border: 1px solid #efe3f5;
            border-radius: 16px;
            background: linear-gradient(135deg, #faf5fd, #fff8fc);
            color: #66556d;
            line-height: 1.75;
        }

        .score-circle,
        .resultado-circulo,
        .circulo {
            width: 165px;
            height: 165px;
            border-radius: 50%;
            box-shadow: 0 8px 25px rgba(117, 70, 143, .12);
        }

        .aviso,
        .nota,
        .nota-final {
            color: #81788b;
            font-size: 12px;
            line-height: 1.7;
        }

        .volver-inicio,
        .botones,
        .navegacion,
        .acciones-resultado,
        .botones-finales {
            gap: 12px;
        }

        @@media (max-width: 760px) {
            .tarjeta-inicio,
            .tarjeta,
            .card {
                width: 100%;
                padding: 28px 22px;
                border-radius: 23px;
            }

            #inicio {
                padding: 18px 14px;
            }

            h1,
            .tarjeta-inicio h1,
            .tarjeta h1,
            .card h1 {
                font-size: clamp(28px, 6vw, 34px);
            }

            h2,
            .pregunta,
            #pregunta,
            #textoPregunta {
                font-size: 20px;
            }

            .option,
            .opcion {
                min-height: 58px;
                padding: 15px 14px;
                font-size: 14.5px;
            }
        }

        @@media (max-width: 520px) {
            .tarjeta-inicio,
            .tarjeta,
            .card {
                padding: 24px 18px;
                border-radius: 21px;
            }

            .btn-comenzar,
            .boton:not(.boton-secundario),
            .btn:not(.btn-secondary):not(.btn-secundario),
            .btn-principal,
            .btn-secondary,
            .boton-secundario,
            .btn-secundario,
            .btn-volver {
                width: 100%;
                min-width: 0;
            }

            .volver-inicio,
            .botones,
            .navegacion,
            .acciones-resultado,
            .botones-finales {
                align-items: stretch;
            }
        }
        /* ===== FIN DE IDENTIDAD VISUAL COMPARTIDA ===== */

    </style>
</head>

<body>
    @Html.AntiForgeryToken()


    <main class="contenedor">

        <section class="tarjeta" id="tarjetaTest">

            <div style="text-align:center;">
                <span class="etiqueta">TEST AVANZADO · 30 PREGUNTAS</span>
            </div>

            <h1>¿Qué está ocultando?</h1>

            <p class="descripcion">
                Una evaluación más profunda sobre la comunicación,
                la confianza, los comportamientos y los límites dentro
                de tu relación.
            </p>


            <div class="datos-pregunta">
                <span id="contador">Pregunta 1 de 30</span>
                <span class="categoria" id="nombreCategoria">Digital</span>
            </div>

            <div class="barra-fondo">
                <div class="barra-progreso" id="barraProgreso"></div>
            </div>

            <div class="numero" id="numeroPregunta">PREGUNTA 01</div>

            <h2 class="pregunta" id="textoPregunta"></h2>

            <div class="opciones" id="opciones"></div>

            <div class="navegacion">
                <button type="button" class="btn btn-secundario"
                        id="btnAnterior" disabled>
                    Anterior
                </button>


            </div>
            <div style="margin-top: 15px;">
                <a href="@Url.Action("Index", "Home")"
                   class="btn btn-secundario"
                   style="display: inline-block; text-decoration: none;">
                    ← Volver a la página principal
                </a>
            </div>

            <p class="ayuda">
                Selecciona una respuesta para continuar.
            </p>
            <p class="ayuda" id="estadoGuardado" hidden>
            </p>

        </section>

        <section class="tarjeta resultado" id="tarjetaResultado" hidden>

            <span class="etiqueta">ANÁLISIS COMPLETADO</span>

            <h1>Tu resultado</h1>

            <p class="descripcion">
                Este resultado representa las situaciones que identificaste
                durante el test. No es una medida de infidelidad.
            </p>

            <div class="circulo">
                <strong id="porcentaje">0%</strong>
                <span>Índice orientativo</span>
            </div>

            <h2 id="tituloResultado" style="color:#713787;"></h2>

            <div class="mensaje-resultado" id="mensajeResultado"></div>

            <h3 class="subtitulo">Resultado por categorías</h3>

            <div id="resultadosCategorias"></div>

            <p class="nota-final">
                Recuerda que una puntuación elevada no demuestra engaño.
                Los cambios de comportamiento pueden tener distintas
                explicaciones. Lo más importante es conversar sobre lo que
                te preocupa, establecer acuerdos claros y valorar cómo se
                sienten ambas personas dentro de la relación.
            </p>

            <div class="acciones-resultado">
                <button type="button" class="btn btn-principal"
                        id="btnReiniciar">
                    Repetir test
                </button>

                <a href="@Url.Action("Index", "Home")"
                   class="btn btn-secundario"
                   style="text-decoration:none; display:inline-block;">
                    Volver al inicio
                </a>
            </div>

        </section>

    </main>

    <script>

        // ==========================================
        // PREGUNTAS DEL TEST AVANZADO
        // 30 preguntas - 5 categorías
        // ==========================================

        const preguntas = [

            // ======================================
            // CATEGORÍA 1: DIGITAL (6 preguntas)
            // ======================================

            {
                texto: "¿Han conversado sobre qué consideran privacidad y qué consideran ocultar dentro del uso de dispositivos y redes sociales?",
                categoria: "Digital",
                peso: 3,
                opciones: [
                    { texto: "Sí, tenemos acuerdos claros y los respetamos", valor: 0 },
                    { texto: "Lo hemos hablado, pero todavía hay diferencias", valor: 2 },
                    { texto: "Nunca hemos llegado a un acuerdo y esto genera conflictos", valor: 5 }
                ]
            },
            {
                texto: "¿Has observado cambios importantes en la manera en que interactúa públicamente en redes sociales?",
                categoria: "Digital",
                peso: 2,
                opciones: [
                    { texto: "No, su comportamiento se mantiene como siempre", valor: 0 },
                    { texto: "Sí, he notado algunos cambios", valor: 2 },
                    { texto: "Sí, hay cambios frecuentes que no hemos conversado", valor: 5 }
                ]
            },
            {
                texto: "¿Cuando hablan sobre interacciones digitales con otras personas, logran aclarar las dudas sin discusiones?",
                categoria: "Digital",
                peso: 2,
                opciones: [
                    { texto: "Sí, podemos hablarlo tranquilamente", valor: 0 },
                    { texto: "A veces la conversación se vuelve incómoda", valor: 2 },
                    { texto: "Generalmente evita hablar del tema o terminamos discutiendo", valor: 5 }
                ]
            },
            {
                texto: "¿Han tenido desacuerdos sobre el tipo de conversaciones o interacciones que consideran apropiadas en internet?",
                categoria: "Digital",
                peso: 2,
                opciones: [
                    { texto: "No, coincidimos en nuestros acuerdos", valor: 0 },
                    { texto: "Tenemos algunas diferencias", valor: 2 },
                    { texto: "Es un problema recurrente que no hemos resuelto", valor: 5 }
                ]
            },
            {
                texto: "¿Sientes que existen diferencias entre los acuerdos digitales que tienen como pareja y las conductas que observas?",
                categoria: "Digital",
                peso: 3,
                opciones: [
                    { texto: "No, sus acciones coinciden con nuestros acuerdos", valor: 0 },
                    { texto: "En algunas ocasiones he notado diferencias", valor: 2 },
                    { texto: "Frecuentemente observo comportamientos que contradicen nuestros acuerdos", valor: 5 }
                ]
            },
            {
                texto: "¿Las conversaciones sobre privacidad digital terminan sin aclarar tus inquietudes?",
                categoria: "Digital",
                peso: 2,
                opciones: [
                    { texto: "No, normalmente llegamos a entendernos", valor: 0 },
                    { texto: "Algunas inquietudes quedan pendientes", valor: 2 },
                    { texto: "Casi nunca conseguimos aclarar el tema", valor: 5 }
                ]
            },

            // ======================================
            // CATEGORÍA 2: COMUNICACIÓN (6 preguntas)
            // ======================================

            {
