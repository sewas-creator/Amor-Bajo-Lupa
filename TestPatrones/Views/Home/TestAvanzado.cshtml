        function mostrarPregunta() {

            const pregunta = preguntas[indice];

            contador.textContent =
                "Pregunta " + (indice + 1) + " de " + preguntas.length;

            nombreCategoria.textContent = pregunta.categoria;

            numeroPregunta.textContent =
                "PREGUNTA " + String(indice + 1).padStart(2, "0");

            textoPregunta.textContent = pregunta.texto;

            const progreso = ((indice + 1) / preguntas.length) * 100;

            barraProgreso.style.width = progreso + "%";

            opciones.innerHTML = "";

            pregunta.opciones.forEach(function (opcion, posicion) {

                const etiqueta = document.createElement("label");

                etiqueta.className = "opcion";

                const radio = document.createElement("input");

                radio.type = "radio";
                radio.name = "respuesta";
                radio.value = opcion.valor;

                if (respuestas[indice] === opcion.valor) {
                    radio.checked = true;
                    etiqueta.classList.add("seleccionada");
                }

                const texto = document.createElement("span");

                texto.textContent = opcion.texto;

                etiqueta.appendChild(radio);
                etiqueta.appendChild(texto);

                opciones.appendChild(etiqueta);

                radio.addEventListener("change", function () {

                    respuestas[indice] = Number(this.value);

                    document.querySelectorAll(".opcion").forEach(function (elemento) {
                        elemento.classList.remove("seleccionada");
                    });

                    etiqueta.classList.add("seleccionada");

                    // Avanzar automáticamente después de seleccionar
                    setTimeout(function () {

                        if (indice < preguntas.length - 1) {

                            indice++;
                            mostrarPregunta();

                        } else {

                            mostrarResultado();

                        }

                    }, 250);

                });

            });

            btnAnterior.disabled = indice === 0;


        }

        // ==========================================
        // BOTÓN ANTERIOR
        // ==========================================

        btnAnterior.addEventListener("click", function () {

            if (indice > 0) {
                indice--;
                mostrarPregunta();
            }

        });

        // ==========================================
        // CALCULAR RESULTADO
        // ==========================================

        function calcularResultados() {

            let puntuacionTotal = 0;
            let puntuacionMaxima = 0;

            categorias.forEach(function (categoria) {

                let puntosCategoria = 0;
                let maximoCategoria = 0;

                preguntas.forEach(function (pregunta, i) {

                    if (pregunta.categoria === categoria) {

                        puntosCategoria += respuestas[i] * pregunta.peso;

                        maximoCategoria += 5 * pregunta.peso;

                    }

                });

                puntuacionTotal += puntosCategoria;
                puntuacionMaxima += maximoCategoria;

            });

            const porcentaje = puntuacionMaxima > 0
                ? Math.round((puntuacionTotal / puntuacionMaxima) * 100)
                : 0;

            const detalleCategorias = categorias.map(function (categoria) {

                let puntos = 0;
                let maximo = 0;

                preguntas.forEach(function (pregunta, i) {

                    if (pregunta.categoria === categoria) {

                        puntos += respuestas[i] * pregunta.peso;

                        maximo += 5 * pregunta.peso;

                    }

                });

                return {
                    nombre: categoria,
                    puntos: puntos,
                    maximo: maximo,
                    porcentaje: maximo > 0
                        ? Math.round((puntos / maximo) * 100)
                        : 0
                };

            });

            detalleCategorias.sort(function (a, b) {
                return b.porcentaje - a.porcentaje;
            });

            return {
                puntuacionTotal: puntuacionTotal,
                puntuacionMaxima: puntuacionMaxima,
                porcentaje: porcentaje,
                detalleCategorias: detalleCategorias
            };

        }

