        // ==========================================
// GUARDAR RESULTADO EN SQL SERVER
// ==========================================

function mostrarResultado() {

    const resultado = calcularResultados();

    const estado = document.getElementById("estadoGuardado");

    const token = document.querySelector(
        'input[name="__RequestVerificationToken"]'
    );

    if (!token) {
        alert("No se encontró el código de seguridad del formulario.");
        return;
    }

    estado.hidden = false;
    estado.textContent = "Guardando tu resultado...";

    const solicitud = new XMLHttpRequest();

    solicitud.open(
        "POST",
        '@Url.Action("GuardarResultadoAvanzado", "Home")',
        true
    );

    solicitud.setRequestHeader(
        "Content-Type",
        "application/x-www-form-urlencoded; charset=UTF-8"
    );

    const datos =
        "__RequestVerificationToken=" +
        encodeURIComponent(token.value) +
        "&respuestas=" +
        encodeURIComponent(respuestas.join(","));

    solicitud.onreadystatechange = function () {

        if (solicitud.readyState === 4) {

            let respuestaServidor = null;

            try {
                respuestaServidor = JSON.parse(solicitud.responseText);
            }
            catch (error) {
                respuestaServidor = null;
            }

            if (
                solicitud.status === 200 &&
                respuestaServidor &&
                respuestaServidor.ok
            ) {

                estado.hidden = true;

                mostrarResultadoEnPantalla(resultado);

            } else {

                estado.hidden = true;

                const mensaje = respuestaServidor &&
                    respuestaServidor.mensaje
                    ? respuestaServidor.mensaje
                    : "No se pudo guardar el resultado. Inténtalo nuevamente.";

                alert(mensaje);

                // Permitir volver a intentar guardar
                respuestas[indice] = null;

                mostrarPregunta();
            }
        }
    };

    solicitud.onerror = function () {

        estado.hidden = true;

        alert("No se pudo conectar con el servidor. Inténtalo nuevamente.");

        respuestas[indice] = null;

        mostrarPregunta();

    };

    solicitud.send(datos);
}


// ==========================================
// MOSTRAR RESULTADO EN PANTALLA
// ==========================================

function mostrarResultadoEnPantalla(resultado) {

    document.getElementById("porcentaje").textContent =
        resultado.porcentaje + "%";

    const titulo = document.getElementById("tituloResultado");
    const mensaje = document.getElementById("mensajeResultado");

    if (resultado.porcentaje <= 24) {

        titulo.textContent = "Pocas situaciones preocupantes identificadas";

        mensaje.textContent =
            "Tus respuestas reflejan pocas situaciones que actualmente te generan preocupación. " +
            "Continúa fortaleciendo la comunicación y manteniendo acuerdos claros.";

    } else if (resultado.porcentaje <= 49) {

        titulo.textContent = "Algunos temas por conversar";

        mensaje.textContent =
            "Has identificado algunas situaciones que podrían necesitar atención. " +
            "Puede ser útil conversar con tranquilidad, expresar lo que sientes y aclarar expectativas.";

    } else if (resultado.porcentaje <= 74) {

        titulo.textContent = "Varias situaciones merecen atención";

        mensaje.textContent =
            "Tus respuestas muestran varias situaciones que te generan inquietud. " +
            "Conviene hablar sobre los acuerdos, las necesidades y los límites que no están funcionando.";

    } else {

        titulo.textContent = "Muchas situaciones generan inquietud";

        mensaje.textContent =
            "Has identificado numerosas situaciones que afectan tu tranquilidad. " +
            "Considera tener una conversación honesta sobre la relación y buscar apoyo si lo necesitas.";

    }

    const contenedorCategorias =
        document.getElementById("resultadosCategorias");

    contenedorCategorias.innerHTML = "";

    resultado.detalleCategorias.forEach(function (categoria) {

        const bloque = document.createElement("div");

        bloque.className = "categoria-resultado";

        const cabecera = document.createElement("div");

        cabecera.className = "categoria-cabecera";

        const nombre = document.createElement("strong");

        nombre.textContent = categoria.nombre;

        const porcentaje = document.createElement("span");

        porcentaje.textContent = categoria.porcentaje + "%";

        cabecera.appendChild(nombre);
        cabecera.appendChild(porcentaje);

        const barra = document.createElement("div");

        barra.className = "categoria-barra";

        const relleno = document.createElement("div");

        relleno.className = "categoria-relleno";

        relleno.style.width = categoria.porcentaje + "%";

        barra.appendChild(relleno);

        bloque.appendChild(cabecera);
        bloque.appendChild(barra);

        contenedorCategorias.appendChild(bloque);

    });

    tarjetaTest.hidden = true;
    tarjetaResultado.hidden = false;

    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });

}

        // ==========================================
        // REINICIAR TEST
        // ==========================================

        btnReiniciar.addEventListener("click", function () {

            indice = 0;

