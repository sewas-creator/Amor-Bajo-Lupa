@{
    Response.ContentEncoding = System.Text.Encoding.UTF8;
    Response.Charset = "utf-8";
    Response.ContentType = "text/html";
    ViewBag.Title = "Amor Bajo Lupa";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fffdfd" />
    <meta name="description" content="Un espacio para explorar las relaciones, comprender tus emociones y descubrirte a través del autoconocimiento." />
    <title>Amor Bajo Lupa | Psicología, relaciones y autoconocimiento</title>
    <link rel="stylesheet" href="@Url.Content("~/Content/Inicio.css")" />
</head>
<body>
    <div class="abl-page" id="inicio">

        <!-- NAVEGACIÓN PRINCIPAL -->
        <header class="abl-header">
            <div class="abl-container abl-header-inner">
                <a class="abl-brand" href="#inicio" aria-label="Amor Bajo Lupa, ir al inicio">
                    <span class="abl-brand-mark" aria-hidden="true">♥</span>
                    <span>
                        <span class="abl-brand-name">Amor Bajo <span>Lupa</span></span>
                        <span class="abl-brand-caption">Relaciones · Emociones · Tú</span>
                    </span>
                </a>

                <nav class="abl-nav" aria-label="Navegación principal">
                    <a href="#inicio">Inicio</a>
                    <a href="#temas">Temas</a>
                    <a href="#conocenos">Conócenos</a>
                    <a href="#articulos">Artículos</a>
                    <a class="abl-nav-cta" href="#tests">Explorar tests <span aria-hidden="true">↗</span></a>
                </nav>

                <details class="abl-mobile-menu">
                    <summary aria-label="Abrir menú de navegación">☰</summary>
                    <nav class="abl-mobile-panel" aria-label="Navegación móvil">
                        <a href="#inicio">Inicio</a>
                        <a href="#temas">Temas</a>
                        <a href="#conocenos">Conócenos</a>
                        <a href="#articulos">Artículos</a>
                        <a href="#tests">Explorar tests</a>
                    </nav>
                </details>
            </div>
        </header>

        <main>
            <!-- PRESENTACIÓN PRINCIPAL -->
            <section class="abl-hero" aria-labelledby="abl-hero-title">
                <div class="abl-container abl-hero-grid">
                    <div class="abl-hero-copy-block">
                        <p class="abl-eyebrow">Un espacio para mirar hacia dentro</p>
                        <h1 id="abl-hero-title">Comprende tus emociones. <em>Descubre tu interior.</em></h1>
                        <p class="abl-hero-copy">
                            Las relaciones, los sentimientos y las experiencias que vivimos también cuentan nuestra historia.
                            Aquí encontrarás ideas y herramientas para reflexionar, reconocer tus patrones y construir vínculos
                            más conscientes.
                        </p>

                        <div class="abl-hero-actions">
                            <a class="abl-button abl-button-primary" href="#temas">Conoce el proyecto <span aria-hidden="true">→</span></a>
                            <a class="abl-button abl-button-secondary" href="#tests">Explorar los tests</a>
                        </div>

                        <div class="abl-hero-note">
                            <span aria-hidden="true">✦</span>
                            <span>Un lugar para aprender, cuestionarte y conocerte sin juicios.</span>
                        </div>
                    </div>

                    <div class="abl-hero-visual" aria-label="Imágenes sobre comunicación y reflexión personal">
                        <div class="abl-hero-photo">
                            <img src="https://images.pexels.com/photos/6962535/pexels-photo-6962535.jpeg"
                                 alt="Dos personas conversan tranquilamente en una cafetería"
                                 fetchpriority="high" />
                        </div>
                        <div class="abl-photo-small">
                            <img src="https://images.pexels.com/photos/9772776/pexels-photo-9772776.jpeg"
                                 alt="Una mujer escribe en su diario durante un momento de reflexión"
                                 loading="lazy" />
                        </div>
                        <div class="abl-hero-sticker">
                            <span class="abl-hero-sticker-icon" aria-hidden="true">♡</span>
                            <span>
                                <strong>Conocerte también es cuidarte.</strong>
                                <small>Empieza por ti</small>
                            </span>
                        </div>
                    </div>
                </div>
            </section>

            <!-- TEMAS PRINCIPALES -->
            <section class="abl-topics-band" id="temas" aria-labelledby="abl-topics-title">
                <div class="abl-container">
                    <h2 class="abl-topics-heading" id="abl-topics-title">Temas para explorar y comprender</h2>
                    <div class="abl-topics-grid">
                        <a class="abl-topic" href="#articulos">
                            <span class="abl-topic-icon" aria-hidden="true">♡</span>
                            <strong>Relaciones de pareja</strong>
                        </a>
                        <a class="abl-topic" href="#articulos">
                            <span class="abl-topic-icon" aria-hidden="true">✧</span>
                            <strong>Inteligencia emocional</strong>
                        </a>
                        <a class="abl-topic" href="#articulos">
                            <span class="abl-topic-icon" aria-hidden="true">⌁</span>
                            <strong>Confianza y comunicación</strong>
                        </a>
                        <a class="abl-topic" href="#articulos">
                            <span class="abl-topic-icon" aria-hidden="true">◎</span>
                            <strong>Autoconocimiento</strong>
                        </a>
                    </div>
                </div>
            </section>

            <!-- SOBRE AMOR BAJO LUPA -->
            <section class="abl-section" id="conocenos" aria-labelledby="abl-about-title">
                <div class="abl-container abl-about">
                    <div class="abl-about-visual">
                        <div class="abl-about-image">
                            <img src="https://images.pexels.com/photos/2221412/pexels-photo-2221412.jpeg"
                                 alt="Una persona dedica un momento a escribir y ordenar sus pensamientos"
                                 loading="lazy" />
                        </div>
                        <div class="abl-about-caption">
                            “Mirarte con honestidad también es una forma de avanzar.”
                            <span>Una pausa para ti</span>
                        </div>
                    </div>

                    <div class="abl-about-copy">
                        <p class="abl-section-kicker">Conócenos</p>
                        <h2 class="abl-section-title" id="abl-about-title">Un espacio para entender lo que hay detrás de lo que sentimos.</h2>
                        <p class="abl-section-intro">
                            Amor Bajo Lupa nace de una idea sencilla: conocernos mejor puede ayudarnos a construir relaciones
                            más conscientes y una relación más amable con nosotros mismos.
                        </p>
                        <p>
                            Reunimos contenidos sobre vínculos, emociones, comunicación y crecimiento personal. También
                            encontrarás tests interactivos que invitan a observar tus respuestas, reconocer hábitos y abrir
                            nuevas preguntas.
                        </p>
                        <p>
                            No buscamos etiquetarte ni ofrecer respuestas absolutas. Queremos acercarte recursos claros para
                            que puedas reflexionar a tu propio ritmo.
                        </p>
                        <a class="abl-about-link" href="#articulos">Descubre nuestros contenidos <span aria-hidden="true">→</span></a>
                    </div>
                </div>
            </section>

            <!-- ARTÍCULOS PUBLICADOS -->
            <section class="abl-section abl-articles-section" id="articulos" aria-labelledby="abl-articles-title">
                <div class="abl-container">
                    <div class="abl-section-heading-row">
                        <div>
                            <p class="abl-section-kicker">Ideas para seguir explorando</p>
                            <h2 class="abl-section-title" id="abl-articles-title">Lecturas para mirar las cosas de otra manera.</h2>
                            <p class="abl-section-intro">
                                Pequeñas aproximaciones a temas que forman parte de nuestra vida emocional y nuestros vínculos.
                            </p>
                        </div>
                    </div>

                    <div class="abl-articles-grid">
                        <a class="abl-article-card abl-article-card-link" href="@Url.Action("ArticuloConocerse", "Home")" aria-label="Leer artículo: ¿Qué significa conocerse realmente a uno mismo?">
                            <div class="abl-article-photo">
                                <img src="https://images.pexels.com/photos/6962564/pexels-photo-6962564.jpeg"
                                     alt="Una mujer escribe en un cuaderno durante un momento de autoconocimiento"
                                     loading="lazy" />
                            </div>
                            <div class="abl-article-body">
                                <p class="abl-article-category">Autoconocimiento</p>
                                <h3>¿Qué significa conocerse realmente a uno mismo?</h3>
                                <p>Observar tus pensamientos, reconocer tus necesidades y comprender por qué algunas experiencias te afectan.</p>
                                <div class="abl-article-meta"><span>Leer artículo</span> · 5 minutos <span aria-hidden="true">→</span></div>
                            </div>
                        </a>

                        <a class="abl-article-card abl-article-card-link" href="@Url.Action("ArticuloComunicacion", "Home")" aria-label="Leer artículo: ¿Por qué es importante la comunicación en pareja?">
                            <div class="abl-article-photo">
                                <img src="https://images.pexels.com/photos/8366758/pexels-photo-8366758.jpeg"
                                     alt="Una pareja conversa frente a frente en una cafetería"
                                     loading="lazy" />
                            </div>
                            <div class="abl-article-body">
                                <p class="abl-article-category">Relaciones de pareja</p>
                                <h3>¿Por qué es importante la comunicación en pareja?</h3>
                                <p>Escuchar, expresar lo que necesitamos y conversar con respeto puede cambiar la forma de afrontar los desacuerdos.</p>
                                <div class="abl-article-meta"><span>Leer artículo</span> · 6 minutos <span aria-hidden="true">→</span></div>
                            </div>
                        </a>

                        <a class="abl-article-card abl-article-card-link" href="@Url.Action("ArticuloEmociones", "Home")" aria-label="Leer artículo: Aprender a reconocer lo que sentimos">
                            <div class="abl-article-photo">
                                <img src="https://images.pexels.com/photos/7395295/pexels-photo-7395295.jpeg"
                                     alt="Dos amigas comparten una conversación cercana y de apoyo"
                                     loading="lazy" />
                            </div>
                            <div class="abl-article-body">
                                <p class="abl-article-category">Inteligencia emocional</p>
                                <h3>Aprender a reconocer lo que sentimos</h3>
                                <p>Poner nombre a una emoción es un primer paso para comprenderla y elegir cómo queremos responder.</p>
                                <div class="abl-article-meta"><span>Leer artículo</span> · 6 minutos <span aria-hidden="true">→</span></div>
                            </div>
                        </a>

                        <a class="abl-article-card abl-article-card-link" href="@Url.Action("ArticuloLimites", "Home")" aria-label="Leer artículo: ¿Cómo aprender a establecer límites saludables?">
                            <div class="abl-article-photo">
                                <img src="https://images.pexels.com/photos/7984914/pexels-photo-7984914.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=1200"
                                     alt="Dos amigas conversan sentadas en un sofá luminoso"
                                     loading="lazy" />
                            </div>
                            <div class="abl-article-body">
                                <p class="abl-article-category">Límites saludables</p>
                                <h3>¿Cómo aprender a establecer límites saludables?</h3>
                                <p>Aprende a comunicar tus necesidades, cuidar tu espacio personal y construir vínculos basados en el respeto mutuo.</p>
                                <div class="abl-article-meta"><span>Leer artículo</span> · 7 minutos <span aria-hidden="true">→</span></div>
                            </div>
                        </a>
                    </div>
                </div>
            </section>

            <!-- TESTS ACTUALES: SE CONSERVAN LAS CUATRO RUTAS EXISTENTES -->
            <section class="abl-section abl-tests-section" id="tests" aria-labelledby="abl-tests-title">
                <div class="abl-container">
                    <div class="abl-tests-head">
                        <div>
                            <p class="abl-section-kicker">Conócete a través de la reflexión</p>
                            <h2 class="abl-section-title" id="abl-tests-title">Explora nuestros tests</h2>
                            <p class="abl-section-intro">
                                Elige una experiencia y dedica unos minutos a observar tus emociones, comportamientos y formas de relacionarte.
                            </p>
                        </div>
                        <span class="abl-test-counter">♥ 5 EXPERIENCIAS</span>
                    </div>

                    <div class="abl-tests-grid">
                        <article class="abl-test-card">
                            <div class="abl-test-top">
                                <span class="abl-test-icon" aria-hidden="true">♡</span>
                                <span class="abl-test-status">Sin iniciar sesión</span>
                            </div>
                            <h3>¿Qué está ocultando?</h3>
                            <p>
                                Responde 12 preguntas sobre comportamientos, comunicación, confianza y límites en tu relación.
                                Obtén un resultado orientativo para reflexionar.
                            </p>
                            <a class="abl-button abl-button-primary" href="@Url.Action("TestPatrones", "Home")">Comenzar test <span aria-hidden="true">→</span></a>
                        </article>

                        <article class="abl-test-card">
                            <div class="abl-test-top">
                                <span class="abl-test-icon" aria-hidden="true">✧</span>
                                <span class="abl-test-status">Sin iniciar sesión</span>
                            </div>
                            <h3>Descubre tus patrones</h3>
                            <p>
                                Explora tus emociones, expectativas y hábitos dentro de una relación para identificar patrones
                                personales y nuevas preguntas.
                            </p>
                            <a class="abl-button abl-button-primary" href="@Url.Action("DescubrePatrones", "Home")">Comenzar test <span aria-hidden="true">→</span></a>
                        </article>

                        <article class="abl-test-card">
                            <div class="abl-test-top">
                                <span class="abl-test-icon" aria-hidden="true">♥</span>
                                <span class="abl-test-status abl-test-status-google">Requiere Google</span>
                            </div>
                            <h3>¿Qué está ocultando? (Avanzado)</h3>
                            <p>
                                Profundiza mediante 30 preguntas sobre privacidad, comunicación, cambios de comportamiento,
                                tiempo y límites. Incluye un análisis orientativo por categorías.
                            </p>
                            <a class="abl-button abl-button-primary" href="@Url.Action("TestAvanzado", "Home")">Comenzar test avanzado <span aria-hidden="true">→</span></a>
                        </article>

                        <article class="abl-test-card">
                            <div class="abl-test-top">
                                <span class="abl-test-icon" aria-hidden="true">◎</span>
                                <span class="abl-test-status abl-test-status-google">Requiere Google</span>
                            </div>
                            <h3>Descubre tus patrones (Avanzado)</h3>
                            <p>
                                Explora con 30 preguntas tus emociones, expectativas, hábitos, comunicación y autonomía.
                                Obtén un análisis personal por categorías.
                            </p>
                            <a class="abl-button abl-button-primary" href="@Url.Action("DescubrePatronesAvanzado", "Home")">Comenzar test avanzado <span aria-hidden="true">→</span></a>
                        </article>

                        <article class="abl-test-card">
                            <div class="abl-test-top">
                                <span class="abl-test-icon" aria-hidden="true">♡</span>
                                <span class="abl-test-status abl-test-status-google">Experiencia premium</span>
                            </div>
                            <h3>¿Estás listo realmente para una relación?</h3>
                            <p>
                                Una experiencia personal de 10 preguntas para explorar tu bienestar emocional,
                                tus experiencias pasadas, el apego, tu autonomía y lo que buscas al amar.
                            </p>
                            <div class="abl-article-meta">S/ 3.00 · Acceso por intento · Próximamente</div>
                        </article>
                    </div>

                    <aside class="abl-disclaimer">
                        <span class="abl-disclaimer-icon" aria-hidden="true">i</span>
                        <div>
                            <strong>Una aclaración importante:</strong>
                            los tests de Amor Bajo Lupa son herramientas orientativas de reflexión personal.
                            No demuestran una infidelidad, no determinan lo que otra persona piensa o hace y no sustituyen
                            una conversación honesta ni una evaluación profesional.
                        </div>
                    </aside>
                </div>
            </section>

            <!-- INVITACIÓN FINAL -->
            <section class="abl-container" aria-labelledby="abl-final-title">
                <div class="abl-final-cta">
                    <p class="abl-section-kicker">Tu historia también merece atención</p>
                    <h2 id="abl-final-title">A veces, entenderte es el comienzo de algo nuevo.</h2>
                    <p>
                        Date un momento para explorar tus emociones, reconocer lo que necesitas y descubrir nuevas perspectivas.
                    </p>
                    <a class="abl-button" href="#tests">Empieza a explorar <span aria-hidden="true">→</span></a>
                </div>
            </section>
        </main>

        <!-- PIE DE PÁGINA -->
        <footer class="abl-footer">
            <div class="abl-container">
                <div class="abl-footer-main">
                    <div class="abl-footer-about">
                        <a class="abl-brand" href="#inicio">
                            <span class="abl-brand-mark" aria-hidden="true">♥</span>
                            <span>
                                <span class="abl-brand-name">Amor Bajo <span>Lupa</span></span>
                                <span class="abl-brand-caption">Relaciones · Emociones · Tú</span>
                            </span>
                        </a>
                        <p>
                            Un espacio digital para reflexionar sobre las relaciones humanas, comprender las emociones
                            y fomentar el autoconocimiento.
                        </p>
                    </div>

                    <div class="abl-footer-column">
                        <h3>Explora</h3>
                        <a href="#temas">Temas</a>
                        <a href="#conocenos">Conócenos</a>
                        <a href="#articulos">Artículos</a>
                        <a href="#tests">Tests</a>
                    </div>

                    <div class="abl-footer-column">
                        <h3>Amor Bajo Lupa</h3>
                        <a href="#inicio">Volver al inicio ↑</a>
                        <a href="#tests">Experiencias interactivas</a>
                        <a href="#articulos">Nuestros artículos</a>
                    </div>
                </div>

                <div class="abl-footer-bottom">
                    <span>© @DateTime.Now.Year Amor Bajo Lupa. Todos los derechos reservados.</span>
                    <span class="abl-photo-credits">
                        Fotografías de <a href="https://www.pexels.com/" target="_blank" rel="noopener noreferrer">Pexels</a>.
                    </span>
                </div>
            </div>
        </footer>

    </div>
</body>
</html>