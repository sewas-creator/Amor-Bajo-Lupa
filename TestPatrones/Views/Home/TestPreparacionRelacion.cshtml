
@{
    Layout = null;
    ViewBag.Title = "¿Estás listo realmente para una relación? | Amor Bajo Lupa";

    bool vistaPrevia = ViewBag.VistaPrevia is bool && (bool)ViewBag.VistaPrevia;
    bool puedeIniciar = ViewBag.PuedeIniciar is bool && (bool)ViewBag.PuedeIniciar;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>¿Estás listo realmente para una relación? | Amor Bajo Lupa</title>

    <style>
        * {
            box-sizing: border-box;
        }

        [hidden] {
            display: none !important;
        }

        body {
            margin: 0;
            min-height: 100vh;
            padding: 26px 15px;
            font-family: "Segoe UI", Arial, sans-serif;
            color: #30283a;
            background: linear-gradient(135deg, #f1e5ff 0%, #fbf5ff 50%, #ffe8f3 100%);
        }

        .contenedor {
            max-width: 850px;
            margin: 0 auto;
        }

        .encabezado {
            text-align: center;
            margin-bottom: 22px;
        }

        .marca {
            color: #713787;
            font-size: 22px;
            font-weight: 800;
            text-decoration: none;
        }

        .tarjeta {
            padding: 36px;
            background: rgba(255,255,255,.96);
            border: 1px solid #fff;
            border-radius: 26px;
            box-shadow: 0 12px 38px rgba(91,50,115,.12);
        }

        .etiqueta {
            display: inline-block;
            padding: 7px 14px;
            border-radius: 20px;
            background: #f4eafa;
            color: #713787;
            font-size: 12px;
            font-weight: 800;
        }

        .etiqueta-previa {
            background: #fff0f7;
            color: #a34d7f;
        }

        h1 {
            margin: 14px 0 12px;
            text-align: center;
            color: #713787;
            font-size: 30px;
            line-height: 1.25;
        }

        .descripcion {
            max-width: 660px;
            margin: 0 auto 24px;
            text-align: center;
            color: #81788b;
            line-height: 1.7;
        }

        .aviso {
            padding: 14px 16px;
            margin: 20px 0 25px;
            border-left: 4px solid #dc8fb9;
            border-radius: 12px;
            background: #fff5fa;
            color: #6f596b;
            font-size: 13px;
            line-height: 1.65;
        }

        .aviso-previa {
            border-left-color: #9251a8;
            background: #f7edfc;
            color: #684477;
        }

        .progreso-texto {
            display: flex;
            justify-content: space-between;
            gap: 10px;
            margin-bottom: 9px;
            color: #81788b;
            font-size: 13px;
        }

        .barra-fondo {
            height: 9px;
            margin-bottom: 28px;
            overflow: hidden;
            border-radius: 20px;
            background: #eee6f3;
        }

        .barra {
            width: 0;
            height: 100%;
            border-radius: inherit;
            background: linear-gradient(90deg,#9251a8,#dc8fb9);
            transition: width .25s ease;
        }

        .categoria {
            margin-bottom: 9px;
            color: #9251a8;
            font-size: 13px;
            font-weight: 800;
        }

        .pregunta {
            margin: 0 0 22px;
            color: #30283a;
            font-size: 22px;
            line-height: 1.5;
        }

        .opciones {
            display: grid;
            gap: 11px;
        }

        .opcion {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 14px 16px;
            border: 2px solid #eee7f2;
            border-radius: 14px;
            color: #51475a;
            cursor: pointer;
            line-height: 1.45;
            transition: .18s ease;
        }

            .opcion:hover {
                border-color: #c99bd9;
                background: #fcf8ff;
            }

            .opcion.seleccionada {
                border-color: #9251a8;
                background: #f7edfc;
                color: #713787;
                font-weight: 600;
            }

            .opcion input {
                width: 18px;
                height: 18px;
                flex-shrink: 0;
                accent-color: #9251a8;
            }

        .ayuda {
            margin-top: 17px;
            text-align: center;
            color: #978da0;
            font-size: 12px;
            line-height: 1.5;
        }

        .resultado {
            text-align: center;
        }

            .resultado h2 {
                color: #713787;
                font-size: 26px;
            }

        .resumen {
            margin: 18px 0;
            padding: 20px;
            border-radius: 16px;
            background: #fbf5ff;
            color: #66556d;
            line-height: 1.75;
        }

        .categoria-resultado {
            margin: 13px 0;
            padding: 17px;
            border: 1px solid #eee5f2;
            border-radius: 14px;
            background: #fff;
            text-align: left;
        }

        .categoria-cabecera {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            color: #713787;
            font-weight: 700;
        }

        .categoria-resultado p {
            margin: 9px 0 0;
            color: #756b7e;
            font-size: 14px;
            line-height: 1.6;
        }

        .barra-categoria {
            height: 8px;
            margin-top: 11px;
            overflow: hidden;
            border-radius: 20px;
            background: #eee6f3;
        }

            .barra-categoria span {
                display: block;
                height: 100%;
                border-radius: inherit;
                background: linear-gradient(90deg,#9251a8,#dc8fb9);
            }

        .reflexion {
            margin: 20px 0;
            padding: 18px;
            border-radius: 15px;
            background: #fff7fb;
            text-align: left;
            color: #6f596b;
            line-height: 1.7;
        }

            .reflexion strong {
                display: block;
                margin-bottom: 7px;
                color: #713787;
            }

        .botones {
            display: flex;
            justify-content: center;
            gap: 12px;
            flex-wrap: wrap;
            margin-top: 25px;
        }

        .btn {
            display: inline-block;
            padding: 12px 22px;
            border: 0;
            border-radius: 25px;
            cursor: pointer;
            text-decoration: none;
            font-weight: 700;
            font-family: inherit;
            font-size: 14px;
        }

        .btn-principal {
            color: #fff;
            background: linear-gradient(135deg,#9251a8,#bd79bd);
        }

            .btn-principal:hover {
                opacity: .92;
            }

        .btn-secundario {
            color: #713787;
            background: #f1e8f5;
        }

            .btn-secundario:hover {
                background: #e9daf0;
            }

        .nota-final {
            margin-top: 23px;
            color: #81788b;
            font-size: 12px;
            line-height: 1.7;
        }

        .nivel-preparacion {
            margin: 20px 0 12px;
            padding: 19px;
            border-radius: 15px;
            font-size: 17px;
            font-weight: 800;
            line-height: 1.5;
            text-align: center;
        }

        .nivel-favorable {
            background: #eff9f1;
            border: 1px solid #c9e8d0;
            color: #28633b;
        }

        .nivel-proceso {
            background: #fff8e9;
            border: 1px solid #f0dfb2;
            color: #806020;
        }

        .nivel-atencion {
            background: #fff0f3;
            border: 1px solid #efcbd5;
            color: #963e59;
        }

        .puntuacion-general {
            margin: 10px 0 20px;
            color: #81788b;
            font-size: 14px;
            text-align: center;
        }

        @@media(max-width:600px) {
            body {
                padding: 15px 9px;
            }

            .tarjeta {
                padding: 25px 18px;
                border-radius: 21px;
            }

            h1 {
                font-size: 25px;
            }

            .pregunta {
                font-size: 19px;
            }

            .opcion {
                padding: 13px;
                font-size: 14px;
            }

            .categoria-cabecera {
                flex-direction: column;
                gap: 4px;
            }
        }
    </style>
</head>

<body>
    <div class="contenedor">

        <header class="encabezado">
            <a class="marca" href="@Url.Action("Index", "Home")">
                Amor Bajo Lupa
            </a>
        </header>

        <main class="tarjeta">

            @if (TempData["ErrorPago"] != null)
            {
                <div class="aviso">@TempData["ErrorPago"]</div>
            }

            @if (TempData["PagoExitoso"] != null)
            {
                <div class="aviso">@TempData["PagoExitoso"]</div>
            }

            <section id="introduccion">

                <div style="text-align:center">
                    @if (vistaPrevia)
                    {
                        <span class="etiqueta etiqueta-previa">
                            VISTA PREVIA LOCAL · SIN PAGO
                        </span>
                    }
                    else
                    {
                        <span class="etiqueta">
                            REFLEXIÓN PERSONAL · 10 PREGUNTAS
                        </span>
                    }
                </div>

                <h1>¿Estás listo realmente para una relación?</h1>

                <p class="descripcion">
                    Antes de compartir tu vida con alguien, también vale la pena mirar cómo te encuentras contigo.
                    Esta experiencia te invita a explorar tu bienestar emocional, tus experiencias pasadas,
                    lo que buscas en el amor y el espacio que tienes para construir un vínculo sano.
                </p>

                <div class="aviso">
                    No hay respuestas buenas o malas. Responde pensando en cómo te has sentido durante los últimos meses,
                    no en cómo crees que deberías sentirte. Puedes tomarte tu tiempo.
                </div>

                @if (puedeIniciar)
                {
                    if (vistaPrevia)
                    {
                        <div class="aviso aviso-previa">
                            <strong>Modo de prueba activado.</strong>
                            Puedes completar las 10 preguntas y visualizar tu resultado.
                            Esta vista previa no realiza ningún pago, no guarda resultados
                            y no consume ningún intento de compra.
                        </div>
                    }
                    else
                    {
                        <p class="ayuda">
                            Tu pago está aprobado. Ya tienes acceso a esta experiencia.
                        </p>
                    }

                    <div class="botones">
                        <button type="button" class="btn btn-principal" id="comenzar">
                            Comenzar reflexión
                        </button>
                    </div>
                }
                else
                {
                    <div class="aviso">
                        Este test es una experiencia premium. Para acceder a las 10 preguntas
                        y obtener tu resultado personalizado, realiza el pago único de S/3.00.
                    </div>

                    <div class="botones">
                        @using (Html.BeginForm("CrearOrdenTestPremium", "Home", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-principal">
                                Pagar S/3.00 y desbloquear test
                            </button>
                        }
                    </div>

                    <p class="ayuda">
                        El acceso se habilitará cuando Mercado Pago confirme tu pago.
                    </p>
                }

            </section>

            @if (puedeIniciar && !vistaPrevia)
            {
                <form id="formularioResultadoPremium" style="display:none;">
                    @Html.AntiForgeryToken()
                </form>
            }

            @if (puedeIniciar)
            {
                <section id="cuestionario" hidden>

                    <div class="progreso-texto">
                        <span id="contador">Pregunta 1 de 10</span>
                        <span id="porcentaje">10%</span>
                    </div>

                    <div class="barra-fondo">
                        <div class="barra" id="barra"></div>
                    </div>

                    <div class="categoria" id="categoria"></div>
                    <h2 class="pregunta" id="pregunta"></h2>
                    <div class="opciones" id="opciones"></div>

                    <p class="ayuda">
                        Elige la opción que mejor represente tu experiencia.
                        Avanzarás automáticamente al seleccionar una respuesta.
                    </p>
                </section>

                <section id="resultado" class="resultado" hidden>

                    <span class="etiqueta">TU ESPACIO DE REFLEXIÓN</span>

                    <h2 id="tituloResultado">Tu orientación sobre iniciar una relación</h2>

                    <div id="nivelPreparacion" class="nivel-preparacion"></div>
                    <p id="porcentajeGeneral" class="puntuacion-general"></p>
                    <div class="resumen" id="resumenResultado"></div>

                    @if (vistaPrevia)
                    {
                        <div class="aviso aviso-previa">
                            <strong>Resultado de vista previa.</strong>
                            Este resultado es únicamente de prueba.
                            No se ha guardado en la base de datos ni se ha consumido
                            ningún intento de compra.
                        </div>
                    }
                    else
                    {
                        <div id="estadoGuardado" class="aviso" role="status" aria-live="polite">
                            Estamos guardando tu resultado...
                        </div>
                    }

                    <h3 style="color:#713787;text-align:left">
                        Lo que puedes explorar en cada área
                    </h3>

                    <div id="categoriasResultado"></div>

                    <div class="reflexion">
                        <strong>Una pregunta para llevar contigo</strong>
                        <span id="preguntaReflexion"></span>
                    </div>

                    <p class="nota-final">
                        Este resultado es orientativo y se basa únicamente en tus respuestas.
                        No diagnostica dependencia emocional, trauma ni ninguna condición psicológica,
                        y no determina si debes o no iniciar una relación.
                        Si alguna experiencia te genera sufrimiento persistente,
                        conversar con un profesional puede ayudarte.
                    </p>

                    <div class="botones">
                        @if (vistaPrevia)
                        {
                            <button type="button" class="btn btn-secundario" id="reiniciar">
                                Volver a responder
                            </button>
                        }

                        <a class="btn btn-principal" href="@Url.Action("Index", "Home")">
                            Volver al inicio
                        </a>
                    </div>
                </section>
            }

        </main>
    </div>

    @if (puedeIniciar)
    {
        <script>
            (function () {
                "use strict";

                var vistaPrevia = @vistaPrevia.ToString().ToLowerInvariant();
                var guardadoIniciado = false;
                var urlGuardarResultado = '@Url.Action("GuardarResultadoTestPremium", "Home")';

                var preguntas = [
                    {
                        categoria: "Bienestar emocional",
                        texto: "En general, puedo reconocer cómo me siento y darme espacio para atender mis emociones.",
                        positiva: true
                    },
                    {
                        categoria: "Bienestar emocional",
                        texto: "Cuando atravieso un momento difícil, siento que necesito una pareja para poder estar bien.",
                        positiva: false
                    },
                    {
                        categoria: "Experiencias pasadas",
                        texto: "Puedo reconocer que una experiencia pasada me afectó sin asumir automáticamente que una nueva persona actuará de la misma manera.",
                        positiva: true
                    },
                    {
                        categoria: "Experiencias pasadas",
                        texto: "Cuando alguien se acerca emocionalmente, suelo anticipar que podría hacerme daño o abandonarme.",
                        positiva: false
                    },
                    {
                        categoria: "Amor y apego",
                        texto: "Me interesa construir un vínculo con alguien por quien realmente es, no solo por la atención que me ofrece.",
                        positiva: true
                    },
                    {
                        categoria: "Amor y apego",
                        texto: "Busco una relación principalmente para aliviar la soledad o sentir que alguien me necesita.",
                        positiva: false
                    },
                    {
                        categoria: "Autonomía personal",
                        texto: "Puedo disfrutar de mi tiempo, mis proyectos y mis amistades sin sentir que me falta una pareja.",
                        positiva: true
                    },
                    {
                        categoria: "Autonomía personal",
                        texto: "Creo que estar en una relación me haría sentir más valioso o una persona más completa.",
                        positiva: false
                    },
                    {
                        categoria: "Preparación emocional",
                        texto: "Puedo expresar mis necesidades y respetar los límites de otra persona, incluso cuando no coincidimos.",
                        positiva: true
                    },
                    {
                        categoria: "Preparación emocional",
                        texto: "Estoy dispuesto a construir una relación con paciencia, comunicación y responsabilidad afectiva.",
                        positiva: true
                    }
                ];

                var opciones = [
                    { texto: "No me describe", valor: 1 },
                    { texto: "Me describe poco", valor: 2 },
                    { texto: "A veces me describe", valor: 3 },
                    { texto: "Me describe bastante", valor: 4 },
                    { texto: "Me describe mucho", valor: 5 }
                ];

                var descripciones = {
                    "Bienestar emocional":
                        "Observa cómo reconoces tus emociones y qué recursos personales utilizas cuando atraviesas momentos difíciles.",

                    "Experiencias pasadas":
                        "Explora si recuerdos o aprendizajes anteriores influyen en la confianza que construyes hoy, sin juzgarte por ello.",

                    "Amor y apego":
                        "Reflexiona sobre cuánto espacio tienen el deseo de compartir, la compañía y la necesidad de aliviar la soledad.",

                    "Autonomía personal":
                        "Considera cómo conviven tu vida individual, tus intereses y el deseo de formar una pareja.",

                    "Preparación emocional":
                        "Piensa en tu disposición para comunicarte, respetar límites y asumir responsabilidades dentro de un vínculo."
                };

                var nombres = [
                    "Bienestar emocional",
                    "Experiencias pasadas",
                    "Amor y apego",
                    "Autonomía personal",
                    "Preparación emocional"
                ];

                var respuestas = new Array(preguntas.length).fill(null);
                var indice = 0;

                var intro = document.getElementById("introduccion");
                var cuestionario = document.getElementById("cuestionario");
                var resultado = document.getElementById("resultado");
                var botonComenzar = document.getElementById("comenzar");

                function mostrarPregunta() {
                    var actual = preguntas[indice];

                    document.getElementById("contador").textContent =
                        "Pregunta " + (indice + 1) + " de " + preguntas.length;

                    document.getElementById("porcentaje").textContent =
                        Math.round(((indice + 1) / preguntas.length) * 100) + "%";

                    document.getElementById("barra").style.width =
                        ((indice + 1) / preguntas.length * 100) + "%";

                    document.getElementById("categoria").textContent = actual.categoria;
                    document.getElementById("pregunta").textContent = actual.texto;

                    var contenedor = document.getElementById("opciones");
                    contenedor.innerHTML = "";

                    opciones.forEach(function (opcion) {
                        var etiqueta = document.createElement("label");
                        etiqueta.className = "opcion";

                        if (respuestas[indice] === opcion.valor) {
                            etiqueta.classList.add("seleccionada");
                        }

                        var radio = document.createElement("input");
                        radio.type = "radio";
                        radio.name = "respuesta";
                        radio.value = opcion.valor;
                        radio.checked = respuestas[indice] === opcion.valor;

                        var texto = document.createElement("span");
                        texto.textContent = opcion.texto;

                        etiqueta.appendChild(radio);
                        etiqueta.appendChild(texto);

                        radio.addEventListener("change", function () {
                            if (!radio.checked) return;

                            respuestas[indice] = opcion.valor;

                            if (indice < preguntas.length - 1) {
                                indice++;
                                mostrarPregunta();
                            } else {
                                mostrarResultado();
                            }
                        });

                        contenedor.appendChild(etiqueta);
                    });
                }

                function guardarResultadoPremium() {
                    if (vistaPrevia || guardadoIniciado) return;

                    guardadoIniciado = true;

                    var estado = document.getElementById("estadoGuardado");

                    var token = document.querySelector(
                        '#formularioResultadoPremium input[name="__RequestVerificationToken"]'
                    );

                    if (!estado || !token) {
                        if (estado) {
                            estado.textContent =
                                "No se encontró el token de seguridad. No se pudo enviar el resultado.";
                        }
                        return;
                    }

                    estado.textContent = "Estamos guardando tu resultado...";

                    var solicitud = new XMLHttpRequest();
                    solicitud.open("POST", urlGuardarResultado, true);

                    solicitud.setRequestHeader(
                        "Content-Type",
                        "application/x-www-form-urlencoded; charset=UTF-8"
                    );

                    solicitud.setRequestHeader("Accept", "application/json");

                    solicitud.onreadystatechange = function () {
                        if (solicitud.readyState !== 4) return;

                        var respuesta = null;

                        try {
                            respuesta = JSON.parse(solicitud.responseText);
                        } catch (error) {
                            respuesta = null;
                        }

                        if (
                            solicitud.status >= 200 &&
                            solicitud.status < 300 &&
                            respuesta &&
                            respuesta.ok
                        ) {
                            estado.textContent =
                                "¡Tu resultado se guardó correctamente! Puntuación: " +
                                respuesta.porcentaje +
                                "%. Tu acceso premium ha sido utilizado.";

                            estado.className = "aviso aviso-previa";
                        } else {
                            estado.textContent =
                                respuesta && respuesta.mensaje
                                    ? respuesta.mensaje
                                    : "No se pudo confirmar el guardado de tu resultado. Comprueba tu acceso antes de intentar nuevamente.";

                            estado.className = "aviso";
                        }
                    };

                    var datos =
                        "respuestas=" +
                        encodeURIComponent(respuestas.join(",")) +
                        "&__RequestVerificationToken=" +
                        encodeURIComponent(token.value);

                    solicitud.send(datos);
                }

                function mostrarResultado() {
                    var puntuaciones = {};

                    nombres.forEach(function (nombre) {
                        puntuaciones[nombre] = [];
                    });

                    preguntas.forEach(function (pregunta, i) {
                        var valor = respuestas[i];

                        var puntuacion = pregunta.positiva
                            ? valor
                            : 6 - valor;

                        puntuaciones[pregunta.categoria].push(puntuacion);
                    });

                    var porcentajes = nombres.map(function (nombre) {
                        var valores = puntuaciones[nombre];

                        var promedio = valores.reduce(function (a, b) {
                            return a + b;
                        }, 0) / valores.length;

                        return {
                            nombre: nombre,
                            porcentaje: Math.round(((promedio - 1) / 4) * 100)
                        };
                    });

                    var general = Math.round(
                        porcentajes.reduce(function (suma, item) {
                            return suma + item.porcentaje;
                        }, 0) / porcentajes.length
                    );

                    var titulo;
                    var resumen;
                    var claseNivel;

                    if (general >= 70) {
                        titulo = "¡Tus respuestas reflejan una buena base para iniciar una relación!";

                        resumen =
                            "Tus respuestas indican que cuentas con recursos personales favorables " +
                            "para comenzar una relación. Pareces tener una base que puede ayudarte " +
                            "a compartir con alguien desde la elección, la comunicación y el respeto. " +
                            "Puedes darte la oportunidad de conocer a alguien y construir un vínculo " +
                            "sin dejar de cuidar tu bienestar y tu independencia.";

                        claseNivel = "nivel-favorable";
                    } else if (general >= 40) {
                        titulo = "Estás en proceso de preparación para una relación";

                        resumen =
                            "Tus respuestas muestran que tienes algunas fortalezas, pero también " +
                            "hay aspectos emocionales que merecen atención. Esto no significa que " +
                            "no puedas iniciar una relación. Puedes conocer a alguien y avanzar " +
                            "con tranquilidad, siempre que seas consciente de tus necesidades, " +
                            "comuniques lo que sientes y respetes tus propios límites.";

                        claseNivel = "nivel-proceso";
                    } else {
                        titulo = "Por ahora, sería recomendable priorizar tu bienestar emocional";

                        resumen =
                            "Tus respuestas sugieren que podrías estar atravesando necesidades " +
                            "emocionales o inseguridades que merecen más atención. Antes de " +
                            "comprometerte con una relación, puede ser beneficioso fortalecer " +
                            "tu bienestar, comprender mejor tus emociones y recuperar tu espacio " +
                            "personal. Esto no significa que no seas capaz de amar ni que debas " +
                            "esperar a ser una persona perfecta para tener una relación.";

                        claseNivel = "nivel-atencion";
                    }

                    document.getElementById("nivelPreparacion").textContent = titulo;

                    document.getElementById("nivelPreparacion").className =
                        "nivel-preparacion " + claseNivel;

                    document.getElementById("porcentajeGeneral").textContent =
                        "Indicador orientativo de preparación: " + general + "%";

                    document.getElementById("resumenResultado").textContent = resumen;

                    var lista = document.getElementById("categoriasResultado");
                    lista.innerHTML = "";

                    porcentajes.forEach(function (item) {
                        var bloque = document.createElement("div");
                        bloque.className = "categoria-resultado";

                        var cabecera = document.createElement("div");
                        cabecera.className = "categoria-cabecera";

                        var nombre = document.createElement("span");
                        nombre.textContent = item.nombre;

                        var valor = document.createElement("span");
                        valor.textContent = "Nivel de recursos: " + item.porcentaje + "%";

                        cabecera.appendChild(nombre);
                        cabecera.appendChild(valor);

                        var barraFondo = document.createElement("div");
                        barraFondo.className = "barra-categoria";

                        var relleno = document.createElement("span");
                        relleno.style.width = item.porcentaje + "%";

                        barraFondo.appendChild(relleno);

                        var descripcion = document.createElement("p");
                        descripcion.textContent = descripciones[item.nombre];

                        bloque.appendChild(cabecera);
                        bloque.appendChild(barraFondo);
                        bloque.appendChild(descripcion);

                        lista.appendChild(bloque);
                    });

                    var menor = porcentajes.reduce(function (a, b) {
                        return a.porcentaje <= b.porcentaje ? a : b;
                    });

                    document.getElementById("preguntaReflexion").textContent =
                        menor.nombre === "Bienestar emocional"
                            ? "¿Qué podrías hacer esta semana para cuidar de ti sin esperar a que otra persona resuelva lo que sientes?"
                            : menor.nombre === "Experiencias pasadas"
                                ? "¿Qué necesitas reconocer de tu historia para no cargar automáticamente ese temor a un vínculo nuevo?"
                                : menor.nombre === "Amor y apego"
                                    ? "Si hoy te sintieras acompañado y en calma, ¿qué te gustaría compartir con alguien desde la libertad?"
                                    : menor.nombre === "Autonomía personal"
                                        ? "¿Qué parte de tu vida individual te gustaría fortalecer y conservar al iniciar una relación?"
                                        : "¿Qué conversación honesta sobre necesidades y límites te gustaría aprender a tener?";

                    cuestionario.hidden = true;
                    resultado.hidden = false;

                    guardarResultadoPremium();

                    window.scrollTo({
                        top: 0,
                        behavior: "smooth"
                    });
                }

                // Iniciar el test al pulsar el botón.
                if (botonComenzar) {
                    botonComenzar.addEventListener("click", function () {
                        intro.hidden = true;
                        cuestionario.hidden = false;

                        indice = 0;
                        mostrarPregunta();

                        window.scrollTo({
                            top: 0,
                            behavior: "smooth"
                        });
                    });
                }

                // Reiniciar solo está disponible en la vista previa.
                var botonReiniciar = document.getElementById("reiniciar");

                if (botonReiniciar) {
                    botonReiniciar.addEventListener("click", function () {
                        respuestas = new Array(preguntas.length).fill(null);
                        indice = 0;

                        resultado.hidden = true;
                        cuestionario.hidden = false;

                        mostrarPregunta();

                        window.scrollTo({
                            top: 0,
                            behavior: "smooth"
                        });
                    });
                }

            }());
        </script>
    }

</body>
</html>
