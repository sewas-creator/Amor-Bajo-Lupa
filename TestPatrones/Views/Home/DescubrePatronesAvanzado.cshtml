        let indice = 0;
        let respuestas = new Array(preguntas.length).fill(null);

        const zonaTest = document.getElementById("zonaTest");
        const zonaResultado = document.getElementById("zonaResultado");


        function mostrarPregunta() {

            const pregunta = preguntas[indice];

            document.getElementById("numeroPregunta").textContent =
                "Pregunta " + (indice + 1) + " de " + preguntas.length;

            const progreso = (indice / preguntas.length) * 100;

            document.getElementById("porcentajeProgreso").textContent =
                Math.round(progreso) + "%";

            document.getElementById("barraProgreso").style.width =
                progreso + "%";

            document.getElementById("categoriaPregunta").textContent =
                pregunta.categoria;

            document.getElementById("textoPregunta").textContent =
                pregunta.texto;

            const contenedor = document.getElementById("contenedorOpciones");
            contenedor.innerHTML = "";

            pregunta.opciones.forEach(function (opcion) {

                const etiqueta = document.createElement("label");
                etiqueta.className = "opcion";

                const radio = document.createElement("input");
                radio.type = "radio";
                radio.name = "respuesta";
                radio.value = opcion.valor;

                radio.checked = respuestas[indice] === opcion.valor;

                if (radio.checked) {
                    etiqueta.classList.add("seleccionada");
                }

                radio.addEventListener("change", function () {

                    respuestas[indice] = opcion.valor;

                    const todas = document.querySelectorAll(".opcion");

                    todas.forEach(function (elemento) {
                        elemento.classList.remove("seleccionada");
                    });

                    etiqueta.classList.add("seleccionada");

                    setTimeout(function () {

                        if (indice < preguntas.length - 1) {
                            indice++;
                            mostrarPregunta();
                        } else {
                            mostrarResultado();
                        }

                    }, 250);

                });

                etiqueta.appendChild(radio);
                etiqueta.appendChild(document.createTextNode(opcion.texto));

                contenedor.appendChild(etiqueta);
            });
        }


        function mostrarResultado() {

            zonaTest.style.display = "none";
            zonaResultado.style.display = "block";

            document.getElementById("barraProgreso").style.width = "100%";

            let total = 0;

            respuestas.forEach(function (valor) {
                total += valor;
            });

            const maximo = preguntas.length * 3;
            const porcentaje = Math.round((total / maximo) * 100);

            document.getElementById("porcentajeResultado").textContent =
                porcentaje + "%";

            let interpretacion = "";

            if (porcentaje <= 25) {
                interpretacion =
                    "Tus respuestas reflejan, en general, recursos personales " +
                    "que pueden ayudarte a gestionar tus emociones, expectativas " +
                    "y límites. Sigue fortaleciendo la comunicación y el equilibrio personal.";
            } else if (porcentaje <= 50) {
                interpretacion =
                    "Tus respuestas muestran algunas áreas que podrían beneficiarse " +
                    "de mayor atención. Reflexionar sobre tus necesidades y la forma " +
                    "en que te relacionas puede ayudarte a construir vínculos más equilibrados.";
            } else if (porcentaje <= 75) {
                interpretacion =
                    "Tus respuestas señalan varias áreas de reflexión. Puede ser útil " +
                    "observar qué situaciones generan inseguridad, dificultad para comunicarte " +
                    "o problemas para mantener tu autonomía.";
            } else {
                interpretacion =
                    "Tus respuestas indican que hay varios aspectos de tu forma de " +
                    "relacionarte que merecen una reflexión cuidadosa. Considera buscar " +
                    "apoyo y trabajar en tus necesidades, límites y bienestar emocional.";
            }

            document.getElementById("interpretacionGeneral").textContent =
                interpretacion;

            const categorias = [
                "Emociones",
                "Expectativas",
                "Hábitos",
                "Comunicación",
                "Autonomía y límites"
            ];

            const descripciones = {
                "Emociones": "Explora cómo reconoces, expresas y gestionas tus emociones.",
                "Expectativas": "Refleja cómo manejas tus expectativas y necesidades afectivas.",
                "Hábitos": "Observa el equilibrio entre tus rutinas personales y la relación.",
                "Comunicación": "Analiza cómo expresas tus ideas, necesidades y desacuerdos.",
                "Autonomía y límites": "Reflexiona sobre tu independencia, privacidad y límites personales."
            };

            const contenedorResultados =
                document.getElementById("resultadosCategorias");

            contenedorResultados.innerHTML = "";

            categorias.forEach(function (categoria) {

                let suma = 0;
                let cantidad = 0;

                preguntas.forEach(function (pregunta, i) {

                    if (pregunta.categoria === categoria) {
                        suma += respuestas[i];
                        cantidad++;
                    }

                });

                const maximoCategoria = cantidad * 3;
                const porcentajeCategoria =
                    Math.round((suma / maximoCategoria) * 100);

                const tarjeta = document.createElement("div");
                tarjeta.className = "categoria-resultado";

                const titulo = document.createElement("strong");
                titulo.textContent = categoria + " · " +
                    porcentajeCategoria + "%";

                const descripcion = document.createElement("p");
                descripcion.textContent = descripciones[categoria];

                const barraFondo = document.createElement("div");
                barraFondo.className = "barra-categoria";

                const barra = document.createElement("div");
                barra.style.width = porcentajeCategoria + "%";

                barraFondo.appendChild(barra);

                tarjeta.appendChild(titulo);
                tarjeta.appendChild(descripcion);
                tarjeta.appendChild(barraFondo);

                contenedorResultados.appendChild(tarjeta);
            });

            guardarResultado(porcentaje);
        }

        function guardarResultado(porcentaje) {

            const token = document.querySelector(
                'input[name="__RequestVerificationToken"]'
            ).value;

            const datos = new URLSearchParams();

            datos.append("__RequestVerificationToken", token);
            datos.append("respuestas", respuestas.join(","));
            datos.append("porcentaje", porcentaje);

            fetch('@Url.Action("GuardarResultadoPatronesAvanzado", "Home")', {
                method: "POST",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8"
                },
                body: datos.toString()
            })
            .then(function (respuesta) {
                if (!respuesta.ok) {
                    throw new Error("No se pudo guardar el resultado.");
                }

                return respuesta.json();
            })
            .then(function (datos) {

                if (datos.ok) {
                    document.getElementById("mensajeGuardado").textContent =
                        "✓ " + (datos.mensaje || "Tu resultado se guardó correctamente.");
                } else {
                    document.getElementById("mensajeGuardado").textContent =
                        datos.mensaje || "No se pudo guardar el resultado.";
                }

            })
            .catch(function () {
                document.getElementById("mensajeGuardado").textContent =
                    "No se pudo guardar el resultado. Comprueba la conexión e inténtalo más tarde.";
            });
        }

        document.getElementById("repetirTest").addEventListener("click", function () {

            indice = 0;
            respuestas = new Array(preguntas.length).fill(null);

            zonaResultado.style.display = "none";
            zonaTest.style.display = "block";

            mostrarPregunta();
        });

        mostrarPregunta();
    </script>

