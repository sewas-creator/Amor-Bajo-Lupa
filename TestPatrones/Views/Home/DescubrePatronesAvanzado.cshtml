
@{
    ViewBag.Title = "Descubre tus Patrones - Análisis Avanzado";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Descubre tus Patrones | Amor Bajo Lupa</title>

    <style>
        :root {
            --primary: #9251a8;
            --primary-dark: #713787;
            --pink: #dc8fb9;
            --background: #f8f5fc;
            --text: #30283a;
            --muted: #81788b;
            --white: #ffffff;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            padding: 25px 15px;
            font-family: "Segoe UI", Arial, sans-serif;
            color: var(--text);
            background: linear-gradient(135deg, #f1e5ff, #fbf5ff 50%, #ffe8f3);
        }

        button, input, select, textarea {
            font: inherit;
        }

        .contenedor {
            max-width: 850px;
            margin: 0 auto;
        }

        .encabezado {
            text-align: center;
            margin-bottom: 25px;
        }

        .marca {
            color: var(--primary-dark);
            font-size: 22px;
            font-weight: bold;
            text-decoration: none;
        }

        .btn-volver {
            display: inline-block;
            margin-top: 15px;
            padding: 10px 18px;
            border: 1px solid #d9c4e5;
            border-radius: 20px;
            color: var(--primary-dark);
            text-decoration: none;
            background: white;
            font-size: 14px;
        }

        .tarjeta {
            background: var(--white);
            padding: 35px;
            border-radius: 25px;
            box-shadow: 0 12px 35px rgba(80, 45, 100, 0.10);
        }

        h1 {
            text-align: center;
            color: var(--primary-dark);
            margin-top: 0;
            font-size: 30px;
        }

        .descripcion {
            text-align: center;
            color: var(--muted);
            line-height: 1.6;
            margin-bottom: 25px;
        }

        .etiqueta {
            display: inline-block;
            padding: 7px 14px;
            border-radius: 20px;
            background: #f5eafb;
            color: var(--primary-dark);
            font-size: 13px;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .progreso-texto {
            display: flex;
            justify-content: space-between;
            color: var(--muted);
            font-size: 13px;
            margin-bottom: 9px;
        }

        .barra-fondo {
            height: 9px;
            width: 100%;
            background: #eee5f3;
            border-radius: 20px;
            overflow: hidden;
            margin-bottom: 30px;
        }

        .barra {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, var(--primary), var(--pink));
            border-radius: 20px;
            transition: width .3s ease;
        }

        .pregunta {
            font-size: 21px;
            line-height: 1.5;
            font-weight: bold;
            margin-bottom: 25px;
        }

        .opciones {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .opcion {
            display: block;
            padding: 16px 18px;
            border: 2px solid #eee5f3;
            border-radius: 15px;
            cursor: pointer;
            transition: .2s;
            line-height: 1.4;
        }

            .opcion:hover {
                border-color: var(--pink);
                background: #fff8fc;
            }

            .opcion.seleccionada {
                border-color: var(--primary);
                background: #f7edfb;
            }

            .opcion input {
                margin-right: 10px;
                accent-color: var(--primary);
            }

        .nota {
            margin-top: 25px;
            text-align: center;
            font-size: 12px;
            color: var(--muted);
            line-height: 1.5;
        }

        .resultado {
            display: none;
        }

            .resultado h2 {
                text-align: center;
                color: var(--primary-dark);
                font-size: 27px;
            }

        .circulo {
            width: 155px;
            height: 155px;
            border-radius: 50%;
            margin: 25px auto;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: #f5eafb;
            border: 9px solid #d9b9e8;
        }

            .circulo strong {
                color: var(--primary-dark);
                font-size: 38px;
            }

            .circulo span {
                color: var(--muted);
                font-size: 12px;
            }

        .interpretacion {
            text-align: center;
            line-height: 1.7;
            color: var(--muted);
        }

        .categoria-resultado {
            padding: 17px;
            margin: 12px 0;
            background: #fbf7fd;
            border: 1px solid #eee3f4;
            border-radius: 14px;
        }

            .categoria-resultado strong {
                display: block;
                color: var(--primary-dark);
                margin-bottom: 8px;
            }

            .categoria-resultado p {
                margin: 0;
                color: var(--muted);
                font-size: 14px;
                line-height: 1.5;
            }

        .barra-categoria {
            height: 7px;
            background: #eadff0;
            border-radius: 20px;
            margin-top: 10px;
            overflow: hidden;
        }

            .barra-categoria div {
                height: 100%;
                background: linear-gradient(90deg, var(--primary), var(--pink));
                border-radius: 20px;
            }

        .botones-finales {
            display: flex;
            justify-content: center;
            gap: 12px;
            flex-wrap: wrap;
            margin-top: 25px;
        }

        .btn {
            border: none;
            border-radius: 25px;
            padding: 13px 23px;
            font-size: 15px;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
        }

        .btn-principal {
            color: white;
            background: var(--primary);
        }

            .btn-principal:hover {
                background: var(--primary-dark);
            }

        .btn-secundario {
            color: var(--primary-dark);
            background: #f3e8f8;
        }

        .mensaje-guardado {
            text-align: center;
            margin-top: 15px;
            color: var(--primary-dark);
            font-size: 14px;
        }

        .oculto {
            display: none;
        }

        @@media (max-width: 600px) {
            .tarjeta {
                padding: 24px 18px;
            }

            h1 {
                font-size: 25px;
            }

            .pregunta {
                font-size: 18px;
            }

            .opcion {
                padding: 14px;
                font-size: 14px;
            }
        }
    
        /* ===== IDENTIDAD VISUAL COMPARTIDA: AMOR BAJO LUPA ===== */
        :root {
            --abl-primary: #9251a8;
            --abl-primary-dark: #713787;
            --abl-pink: #dc8fb9;
            --abl-text: #39264d;
            --abl-muted: #7b7087;
            --abl-border: #eee5f2;
            --abl-soft: #f8f1fc;
            --abl-white: #ffffff;
        }

        body {
            font-family: "Segoe UI", Arial, sans-serif;
            color: var(--abl-text);
            background: linear-gradient(135deg, #f1e5ff 0%, #fbf5ff 48%, #ffe8f3 100%);
        }

        body::before,
        body::after {
            display: none;
        }

        .pagina,
        .contenedor {
            width: min(100%, 850px);
            max-width: 850px;
            margin-left: auto;
            margin-right: auto;
        }

        .tarjeta-inicio,
        .tarjeta,
        .card {
            width: 100%;
            max-width: 850px;
            margin-left: auto;
            margin-right: auto;
            padding: 38px 42px;
            border: 1px solid rgba(234, 227, 240, .95);
            border-radius: 26px;
            background: rgba(255, 255, 255, .96);
            box-shadow: 0 18px 55px rgba(87, 49, 104, .10);
        }

        .tarjeta-inicio {
            text-align: center;
        }

        h1,
        .tarjeta-inicio h1,
        .tarjeta h1,
        .card h1 {
            color: #633b7e;
            font-family: "Segoe UI", Arial, sans-serif;
            font-size: clamp(30px, 4vw, 38px);
            font-weight: 800;
            letter-spacing: -.8px;
            line-height: 1.2;
        }

        h2,
        .pregunta,
        #pregunta,
        #textoPregunta {
            color: #514269;
            font-size: 22px;
            font-weight: 700;
            line-height: 1.5;
        }

        .subtitulo,
        .descripcion {
            color: #756b83;
            font-size: 16px;
            line-height: 1.75;
        }

        .etiqueta,
        #contador,
        .contador,
        .numero,
        .categoria {
            border-radius: 999px;
            color: var(--abl-primary-dark);
        }

        .etiqueta {
            padding: 7px 14px;
            background: #f5eafb;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: .5px;
        }

        .marca {
            color: var(--abl-primary-dark);
            font-family: "Segoe UI", Arial, sans-serif;
            font-size: 23px;
            font-weight: 800;
            text-decoration: none;
        }

        /* Tarjetas de respuesta: mismo tamaño, borde y estado seleccionado. */
        .option,
        .opcion {
            display: flex;
            width: 100%;
            min-height: 60px;
            align-items: center;
            justify-content: flex-start;
            gap: 12px;
            margin: 0;
            padding: 16px 18px;
            border: 1.5px solid var(--abl-border);
            border-radius: 15px;
            background: #fff;
            color: #5e526c;
            font-family: "Segoe UI", Arial, sans-serif;
            font-size: 15px;
            font-weight: 400;
            line-height: 1.5;
            text-align: left;
            cursor: pointer;
            transition: border-color .2s ease, background .2s ease, box-shadow .2s ease, transform .2s ease;
        }

        .option:hover,
        .opcion:hover {
            border-color: #c39bd5;
            background: #fcf8ff;
            transform: translateY(-1px);
            box-shadow: 0 5px 15px rgba(117, 70, 143, .07);
        }

        .option:has(input:checked),
        .opcion:has(input:checked),
        .opcion.seleccionada {
            border-color: var(--abl-primary);
            background: #f7effb;
            color: var(--abl-primary-dark);
        }

        .option input,
        .opcion input {
            width: 19px;
            height: 19px;
            flex: 0 0 19px;
            margin: 0 2px 0 0;
            accent-color: var(--abl-primary);
        }

        .option:focus-within,
        .opcion:focus-within {
            outline: 3px solid #dfc4e9;
            outline-offset: 2px;
        }

        .opciones {
            gap: 12px;
        }

        /* Barras de progreso unificadas. */
        .progress,
        .barra-fondo {
            height: 9px;
            overflow: hidden;
            border-radius: 999px;
            background: #eee7f2;
        }

        .progress-bar,
        .barra,
        .barra-progreso {
            height: 100%;
            border-radius: inherit;
            background: linear-gradient(90deg, #9251a8, #dc8fb9);
            transition: width .3s ease;
        }

        /* Todos los botones principales comparten dimensiones y degradado. */
        .btn-comenzar,
        .boton:not(.boton-secundario),
        .btn:not(.btn-secondary):not(.btn-secundario),
        .btn-principal {
            display: inline-flex;
            min-width: 190px;
            min-height: 48px;
            max-width: 100%;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 13px 22px;
            border: 1px solid transparent;
            border-radius: 14px;
            background: linear-gradient(135deg, #9251a8, #713787);
            box-shadow: 0 7px 18px rgba(146, 81, 168, .20);
            color: #fff;
            font-family: "Segoe UI", Arial, sans-serif;
            font-size: 15px;
            font-weight: 700;
            line-height: 1.25;
            text-align: center;
            text-decoration: none;
            cursor: pointer;
            transition: transform .2s ease, box-shadow .2s ease, background .2s ease;
        }

        .btn-comenzar:hover,
        .boton:not(.boton-secundario):hover,
        .btn:not(.btn-secondary):not(.btn-secundario):hover,
        .btn-principal:hover {
            background: linear-gradient(135deg, #85449c, #60306f);
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 10px 23px rgba(146, 81, 168, .27);
        }

        .btn-secondary,
        .boton-secundario,
        .btn-secundario,
        .btn-volver {
            display: inline-flex;
            min-width: 180px;
            min-height: 46px;
            max-width: 100%;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 11px 20px;
            border: 1px solid #e8daf1;
            border-radius: 14px;
            background: #f8f1fc;
            box-shadow: none;
            color: var(--abl-primary-dark);
            font-family: "Segoe UI", Arial, sans-serif;
            font-size: 14px;
            font-weight: 700;
            line-height: 1.3;
            text-align: center;
            text-decoration: none;
            cursor: pointer;
            transition: transform .2s ease, background .2s ease, border-color .2s ease;
        }

        .btn-secondary:hover,
        .boton-secundario:hover,
        .btn-secundario:hover,
        .btn-volver:hover {
            border-color: #d9c2e6;
            background: #eee1f7;
            color: var(--abl-primary-dark);
            transform: translateY(-1px);
            box-shadow: none;
        }

        .btn:disabled {
            opacity: .45;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

        .btn-comenzar:focus-visible,
        .boton:focus-visible,
        .btn:focus-visible,
        .btn-volver:focus-visible {
            outline: 3px solid #d8b6e8;
            outline-offset: 3px;
        }

        /* Resultados con la misma superficie visual. */
        .result-box,
        .caja-resultado,
        .mensaje-resultado,
        .interpretacion {
            padding: 20px;
            border: 1px solid #efe3f5;
            border-radius: 16px;
            background: linear-gradient(135deg, #faf5fd, #fff8fc);
            color: #66556d;
            line-height: 1.75;
        }

        .score-circle,
        .resultado-circulo,
        .circulo {
            width: 165px;
            height: 165px;
            border-radius: 50%;
            box-shadow: 0 8px 25px rgba(117, 70, 143, .12);
        }

        .aviso,
        .nota,
        .nota-final {
            color: #81788b;
            font-size: 12px;
            line-height: 1.7;
        }

        .volver-inicio,
        .botones,
        .navegacion,
        .acciones-resultado,
        .botones-finales {
            gap: 12px;
        }

        @@media (max-width: 760px) {
            .tarjeta-inicio,
            .tarjeta,
            .card {
                width: 100%;
                padding: 28px 22px;
                border-radius: 23px;
            }

            #inicio {
                padding: 18px 14px;
            }

            h1,
            .tarjeta-inicio h1,
            .tarjeta h1,
            .card h1 {
                font-size: clamp(28px, 6vw, 34px);
            }

            h2,
            .pregunta,
            #pregunta,
            #textoPregunta {
                font-size: 20px;
            }

            .option,
            .opcion {
                min-height: 58px;
                padding: 15px 14px;
                font-size: 14.5px;
            }
        }

        @@media (max-width: 520px) {
            .tarjeta-inicio,
            .tarjeta,
            .card {
                padding: 24px 18px;
                border-radius: 21px;
            }

            .btn-comenzar,
            .boton:not(.boton-secundario),
            .btn:not(.btn-secondary):not(.btn-secundario),
            .btn-principal,
            .btn-secondary,
            .boton-secundario,
            .btn-secundario,
            .btn-volver {
                width: 100%;
                min-width: 0;
            }

            .volver-inicio,
            .botones,
            .navegacion,
            .acciones-resultado,
            .botones-finales {
                align-items: stretch;
            }
        }
        /* ===== FIN DE IDENTIDAD VISUAL COMPARTIDA ===== */

    </style>
</head>

<body>

    @Html.AntiForgeryToken()

    <div class="contenedor">

        <header class="encabezado">
            <a class="marca" href="@Url.Action("Index", "Home")">
                Amor Bajo Lupa
            </a>

        </header>

        <main class="tarjeta">

            <section id="zonaTest">

                <h1><b>Descubre tus Patrones</b></h1>

                <p class="descripcion">
                    Análisis profundo de tus emociones, expectativas,
                    hábitos y formas de relacionarte.
                    Responde con sinceridad y descubre aspectos
                    que pueden ayudarte a conocerte mejor.
                </p>

                <div style="text-align:center;">
                    <span class="etiqueta">ANÁLISIS AVANZADO · 30 PREGUNTAS</span>
                </div>

                <div class="progreso-texto">
                    <span id="numeroPregunta">Pregunta 1 de 30</span>
                    <span id="porcentajeProgreso">0%</span>
                </div>

                <div class="barra-fondo">
                    <div class="barra" id="barraProgreso"></div>
                </div>

                <div id="categoriaPregunta" class="etiqueta"></div>

                <div class="pregunta" id="textoPregunta"></div>

                <div class="opciones" id="contenedorOpciones"></div>

                <div style="margin-top: 15px;">
                    <a href="@Url.Action("Index", "Home")"
                       class="btn btn-secundario"
                       style="display: inline-block; text-decoration: none;">
                        <b> ← Volver a la página principal</b>
                    </a>
                </div>
                
                <p class="nota">
                    No existen respuestas buenas o malas.
                    Este ejercicio busca fomentar la reflexión personal.
                </p>

            </section>

            <section id="zonaResultado" class="resultado">

                <h2>Tu análisis personal</h2>

                <p class="descripcion">
                    Este resultado es una orientación para reflexionar
                    sobre tus respuestas.
                </p>

                <div class="circulo">
                    <strong id="porcentajeResultado">0%</strong>
                    <span>Índice orientativo</span>
                </div>

                <p class="interpretacion" id="interpretacionGeneral"></p>

                <h3 style="color:var(--primary-dark); margin-top:30px;">
                    Análisis por categorías
                </h3>

                <div id="resultadosCategorias"></div>

                <p class="nota">
                    Este resultado no constituye un diagnóstico psicológico
                    ni determina tu capacidad para mantener una relación.
                    Un porcentaje elevado no significa que exista un problema
                    ni que tu relación esté destinada a fracasar.
                </p>

                <div class="mensaje-guardado" id="mensajeGuardado">
                    Guardando tu resultado...
                </div>

                <div class="botones-finales">
                    <button class="btn btn-principal" id="repetirTest">
                        Repetir test
                    </button>

                    <a class="btn btn-secundario"
                       href="@Url.Action("Index", "Home")">
                        Volver al inicio
                    </a>
                </div>

            </section>

        </main>
    </div>

    <script>
        const preguntas = [

            // EMOCIONES (1-6)

            {
                texto: "Cuando siento inseguridad dentro de una relación, normalmente...",
                categoria: "Emociones",
                opciones: [
                    { texto: "Reconozco lo que siento y trato de comprenderlo.", valor: 0 },
                    { texto: "Necesito un tiempo para ordenar mis pensamientos.", valor: 1 },
                    { texto: "Me cuesta controlar mis pensamientos y preocupaciones.", valor: 2 },
                    { texto: "La inseguridad termina afectando gran parte de mi día.", valor: 3 }
                ]
            },
            {
                texto: "Cuando mi pareja está distante emocionalmente...",
                categoria: "Emociones",
                opciones: [
                    { texto: "Respeto su espacio y busco hablar cuando sea oportuno.", valor: 0 },
                    { texto: "Me pregunto si hice algo que le molestó.", valor: 1 },
                    { texto: "Me preocupo bastante y busco señales de lo que sucede.", valor: 2 },
                    { texto: "Siento mucha angustia y necesito una respuesta inmediata.", valor: 3 }
                ]
            },
            {
                texto: "Cuando siento celos, mi reacción habitual es...",
                categoria: "Emociones",
                opciones: [
                    { texto: "Identifico la emoción y analizo si tiene fundamento.", valor: 0 },
                    { texto: "Me cuesta un poco, pero intento manejarla.", valor: 1 },
                    { texto: "Suelo imaginar situaciones que me generan preocupación.", valor: 2 },
                    { texto: "Los celos influyen mucho en mi comportamiento.", valor: 3 }
                ]
            },
            {
                texto: "Cuando discutimos, me resulta difícil...",
                categoria: "Emociones",
                opciones: [
                    { texto: "Mantener la calma y escuchar la otra perspectiva.", valor: 0 },
                    { texto: "Expresar lo que siento sin ponerme a la defensiva.", valor: 1 },
                    { texto: "Evitar reaccionar impulsivamente.", valor: 2 },
                    { texto: "Controlar mis emociones durante el conflicto.", valor: 3 }
                ]
            },
            {
                texto: "Cuando cometo un error en mi relación...",
                categoria: "Emociones",
                opciones: [
                    { texto: "Lo reconozco y trato de repararlo.", valor: 0 },
                    { texto: "Me cuesta aceptarlo, pero puedo hablarlo.", valor: 1 },
                    { texto: "Me culpo durante bastante tiempo.", valor: 2 },
                    { texto: "Siento que el error puede hacer que me dejen.", valor: 3 }
                ]
            },
            {
                texto: "Cuando algo no sale como esperaba en mi relación...",
                categoria: "Emociones",
                opciones: [
                    { texto: "Acepto que no todo puede salir como lo planeo.", valor: 0 },
                    { texto: "Me decepciono, pero consigo adaptarme.", valor: 1 },
                    { texto: "Me cuesta dejar de pensar en lo que salió mal.", valor: 2 },
                    { texto: "La decepción afecta mucho mi estado de ánimo.", valor: 3 }
                ]
            },

            // EXPECTATIVAS (7-12)

            {
                texto: "Cuando imagino cómo debería ser una relación...",
                categoria: "Expectativas",
                opciones: [
                    { texto: "Considero que cada relación tiene su propio ritmo.", valor: 0 },
                    { texto: "Tengo algunas expectativas que puedo adaptar.", valor: 1 },
                    { texto: "Me cuesta aceptar que la realidad sea distinta a lo que imaginé.", valor: 2 },
                    { texto: "Espero que mi pareja cumpla casi siempre con lo que imagino.", valor: 3 }
                ]
            },
            {
                texto: "Si mi pareja no demuestra cariño de la manera que espero...",
                categoria: "Expectativas",
                opciones: [
                    { texto: "Comprendo que cada persona expresa cariño de forma diferente.", valor: 0 },
                    { texto: "Me gustaría que conociera mejor mis necesidades.", valor: 1 },
                    { texto: "Puedo llegar a sentir que no le importo lo suficiente.", valor: 2 },
                    { texto: "Pienso que si me quisiera debería demostrarlo como yo espero.", valor: 3 }
                ]
            },
            {
                texto: "Cuando necesito algo de mi pareja...",
